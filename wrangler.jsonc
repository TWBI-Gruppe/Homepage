// Cloudflare Workers configuration (free plan is enough).
// The D1 database is created automatically on the first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rezeptbox",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep variables set in the dashboard (APP_PASSWORD, ANTHROPIC_MODEL, …)
  // when a new version is deployed; otherwise every deploy would delete them.
  "keep_vars": true,
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/images/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rezeptbox"
    }
  ],
  "observability": {
    "enabled": true
  }
}
